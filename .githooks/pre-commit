#!/bin/sh
# Auto-format staged C/C++ source files with clang-format before committing.

CLANG_FORMAT=$(command -v clang-format)
if [ -z "$CLANG_FORMAT" ]; then
    echo "warning: clang-format not found in PATH; skipping format check" >&2
    exit 0
fi

# Staged files (added/copied/modified/renamed), filtered to C/C++ sources.
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.c' '*.h' '*.cpp' '*.hpp' '*.cc')

if [ -z "$files" ]; then
    exit 0
fi

for f in $files; do
    "$CLANG_FORMAT" -i "$f"
    git add "$f"
done

exit 0
